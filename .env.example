# Copy to .env (git-ignored). The hub needs no secrets.
# HUB_PORT=4600
# Loopback by default. Set HUB_BIND=0.0.0.0 only if you accept anyone on the network reading the hub (it is read-only, no accounts).
# HUB_BIND=127.0.0.1
# Hosted mock only: comma-separated Host names a non-loopback bind answers (required with MOCK_ONLY=1 and a non-loopback HUB_BIND). See README.
# HUB_ALLOWED_HOSTS=
# Pack registry (default data/packs.json) and local overrides (default .data/packs.local.json).
# HUB_REGISTRY=
# HUB_LOCAL_REGISTRY=
# Optional: absolute path of the SE demo shelf registry (demo-shelf data/demos.json). Its demo urls override a pack's demo.baseUrl.
# HUB_SHELF_URL=
