{
  "name": "learning-hub",
  "private": true,
  "workspaces": ["server", "web"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w web",
    "build": "npm run build -w web",
    "doctor": "node scripts/doctor.mjs",
    "validate-pack": "node scripts/validate-pack.mjs",
    "refresh-packs": "node scripts/refresh-packs.mjs",
    "e2e": "node scripts/e2e.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": { "playwright": "1.58.2" }
}
